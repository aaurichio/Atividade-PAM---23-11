<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FinancasApp.Views.PerfilPage" Title="Perfil">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Usuário Exemplo" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" />
                    <Label Text="usuario@exemplo.com" FontSize="13" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Editar perfil" Style="{StaticResource BotaoPrimario}" Clicked="OnEditarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
