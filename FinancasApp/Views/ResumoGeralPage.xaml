<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FinancasApp.Views.ResumoGeralPage" Title="Geral">
    <VerticalStackLayout Padding="20" Spacing="14">
        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout>
                <Label Text="Receitas" TextColor="{StaticResource Gray500}" />
                <Label x:Name="ReceitasLabel" TextColor="{StaticResource Receita}" FontSize="24" FontFamily="OpenSansSemibold" />
            </VerticalStackLayout>
        </Border>
        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout>
                <Label Text="Despesas" TextColor="{StaticResource Gray500}" />
                <Label x:Name="DespesasLabel" TextColor="{StaticResource Despesa}" FontSize="24" FontFamily="OpenSansSemibold" />
            </VerticalStackLayout>
        </Border>
        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout>
                <Label Text="Saldo" TextColor="{StaticResource Gray500}" />
                <Label x:Name="SaldoLabel" FontSize="24" FontFamily="OpenSansSemibold" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>
