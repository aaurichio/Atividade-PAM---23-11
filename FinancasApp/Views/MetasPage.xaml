<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FinancasApp.Models"
             x:Class="FinancasApp.Views.MetasPage"
             Title="Metas">
    <CollectionView x:Name="Lista" Margin="16,12">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Meta">
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding Icone}" FontSize="26" />
                            <Label Text="{Binding Nome}" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <ProgressBar Progress="{Binding Progresso}" ProgressColor="{StaticResource Primary}" />
                        <Label Text="{Binding Texto}" FontSize="12" TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
